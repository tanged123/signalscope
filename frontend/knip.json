{
  "$schema": "https://unpkg.com/knip/schema.json",
  "entry": [
    "src/main.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "scripts/*.mjs",
    "tests/e2e/*.ts"
  ],
  "project": ["src/**/*.ts", "tests/**/*.ts", "scripts/*.mjs", "*.config.ts"],
  "ignore": ["src/generated/**", "src/node-builtins.d.ts"]
}
