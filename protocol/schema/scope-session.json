{
  "schema_version": 15,
  "types": {
    "Theme": {
      "kind": "enum",
      "variants": ["dark", "light"],
      "default": "dark"
    },
    "TimeMode": {
      "kind": "enum",
      "variants": ["fixed", "follow"],
      "default": "fixed"
    },
    "CursorMode": {
      "kind": "enum",
      "variants": ["none", "track", "measure"],
      "default": "none"
    },
    "PanelMode": {
      "kind": "enum",
      "variants": ["time", "xy", "fft", "histogram"]
    },
    "AxisStyle": { "kind": "enum", "variants": ["gutter", "inline"] },
    "DashStyle": { "kind": "enum", "variants": ["solid", "dash", "dot"] },
    "AnnotationDomain": {
      "kind": "enum",
      "variants": ["time", "frequency", "distribution"]
    },
    "LinkedTime": {
      "kind": "object",
      "fields": {
        "t0": "f64",
        "t1": "f64",
        "linked": "bool",
        "paused": "bool",
        "cursorT": "f64?",
        "mode": "TimeMode"
      }
    },
    "SeriesState": {
      "kind": "object",
      "fields": {
        "path": "string",
        "color_slot": "u8",
        "dash": "DashStyle",
        "width": "f32",
        "visible": "bool"
      }
    },
    "Annotation": {
      "kind": "object",
      "fields": {
        "id": "string",
        "series_path": "string",
        "domain": "AnnotationDomain",
        "anchor": "f64",
        "pinned_value": "f64",
        "label": "string"
      }
    },
    "HighlightedSourceState": {
      "kind": "object",
      "fields": {
        "local_path": "string",
        "path": "string"
      }
    },
    "PanelState": {
      "kind": "object",
      "fields": {
        "id": "string",
        "title": "string",
        "mode": "PanelMode",
        "axis_style": "AxisStyle",
        "x_signal": "string?",
        "color_signal": "string?",
        "color_by_time": "bool",
        "series": "SeriesState[]",
        "highlighted_sources": "HighlightedSourceState[]",
        "y_range": "f64[2]?",
        "x_range": "f64[2]?",
        "x_label": "string?",
        "y_label": "string?",
        "c_label": "string?",
        "time_window": "f64[2]?",
        "annotations": "Annotation[]",
        "show_stats": "bool"
      }
    },
    "LayoutCell": {
      "kind": "object",
      "fields": {
        "panel_id": "string",
        "width": "f64"
      }
    },
    "LayoutRow": {
      "kind": "object",
      "fields": {
        "height": "f64",
        "panels": "LayoutCell[]"
      }
    },
    "WorkspaceTab": {
      "kind": "object",
      "fields": {
        "id": "string",
        "title": "string",
        "cursor_mode": "CursorMode",
        "focused_panel_id": "string?",
        "maximized_panel_id": "string?",
        "panels": "PanelState[]",
        "layout": "LayoutRow[]"
      }
    },
    "DerivedSignal": {
      "kind": "object",
      "fields": {
        "path": "string",
        "expr": "string"
      }
    },
    "SourceRecord": {
      "kind": "object",
      "fields": {
        "key": "string",
        "path": "string",
        "prefix": "string",
        "provider_id": "string?",
        "decode_provenance": "string?",
        "reconcile_legacy": "bool"
      }
    },
    "TimeUnitState": {
      "kind": "enum",
      "variants": ["seconds", "milliseconds", "microseconds", "nanoseconds"]
    },
    "OriginKindState": {
      "kind": "enum",
      "variants": [
        "relative",
        "absolute_epoch",
        "event_aligned",
        "synthetic_index"
      ]
    },
    "TimeDomainState": {
      "kind": "object",
      "fields": {
        "unit": "TimeUnitState",
        "origin": "OriginKindState",
        "alignment_origin": "f64"
      }
    },
    "SetMemberState": {
      "kind": "object",
      "fields": {
        "source_key": "string",
        "missing": "string[]",
        "scale": "f64",
        "offset": "f64"
      }
    },
    "SourceSetState": {
      "kind": "object",
      "fields": {
        "key": "string",
        "label": "string",
        "generation": "u64",
        "time_domain": "TimeDomainState",
        "members": "SetMemberState[]"
      }
    },
    "Session": {
      "kind": "object",
      "fields": {
        "app": "string",
        "schema_version": "u32",
        "theme": "Theme",
        "linked_time": "LinkedTime",
        "active_tab_id": "string",
        "tabs": "WorkspaceTab[]",
        "favorites": "string[]",
        "favorite_bundles": "string[]",
        "derived": "DerivedSignal[]",
        "sources": "SourceRecord[]",
        "source_sets": "SourceSetState[]"
      }
    }
  }
}
