{
  "schema_version": 31,
  "types": {
    "Theme": {
      "kind": "enum",
      "variants": ["dark", "light"],
      "default": "dark"
    },
    "TimeMode": {
      "kind": "enum",
      "variants": ["fixed", "follow"],
      "default": "fixed"
    },
    "CursorMode": {
      "kind": "enum",
      "variants": ["none", "track", "measure"],
      "default": "none"
    },
    "AxisStyle": { "kind": "enum", "variants": ["gutter", "inline"] },
    "DashStyle": { "kind": "enum", "variants": ["solid", "dash", "dot"] },
    "StatColumn": {
      "kind": "enum",
      "variants": ["min", "max", "mean", "rms", "cursor", "n"]
    },
    "LinkedTime": {
      "kind": "object",
      "fields": {
        "t0": "f64",
        "t1": "f64",
        "linked": "bool",
        "paused": "bool",
        "cursorT": "f64?",
        "mode": "TimeMode"
      }
    },
    "SeriesRef": {
      "kind": "object",
      "fields": { "source_key": "string", "channel": "string" }
    },
    "SampleAxisSource": {
      "kind": "tagged_union",
      "tag": "kind",
      "variants": {
        "time": {},
        "signal": { "fields": { "ref": "SeriesRef" } },
        "bundle": { "fields": { "refs": "SeriesRef[]" } }
      }
    },
    "ColorAxis": {
      "kind": "object",
      "fields": {
        "source": "SampleAxisSource",
        "range": "f64[2]?",
        "label": "string?"
      }
    },
    "BindingKind": { "kind": "enum", "variants": ["query", "pick", "set"] },
    "Binding": {
      "kind": "object",
      "fields": {
        "kind": "BindingKind",
        "selector": "string?",
        "refs": "SeriesRef[]",
        "set_id": "string?"
      }
    },
    "SeriesOverride": {
      "kind": "object",
      "fields": {
        "target_ref": "SeriesRef?",
        "target_selector": "string?",
        "color_slot": "u8?",
        "dash": "DashStyle?",
        "width": "f32?",
        "opacity": "f32?",
        "visible": "bool?"
      }
    },
    "FocusKind": {
      "kind": "enum",
      "variants": ["series", "source", "channel"]
    },
    "FocusEntry": {
      "kind": "object",
      "fields": {
        "kind": "FocusKind",
        "ref": "SeriesRef?",
        "source_key": "string?",
        "channel": "string?"
      }
    },
    "GhostMode": {
      "kind": "enum",
      "variants": ["ghost", "all"],
      "default": "all"
    },
    "StyleDimension": {
      "kind": "enum",
      "variants": ["focus", "source", "channel", "set", "attr"],
      "default": "source"
    },
    "LegendState": {
      "kind": "enum",
      "variants": ["badge", "keys", "roster", "rail"],
      "default": "keys"
    },
    "LegendAnchor": {
      "kind": "enum",
      "variants": ["top_left", "top_right", "bottom_left", "bottom_right"]
    },
    "LegendDock": {
      "kind": "enum",
      "variants": ["left", "right", "top", "bottom"]
    },
    "NamedSetKind": { "kind": "enum", "variants": ["query", "pick"] },
    "AnnotationDisplay": {
      "kind": "enum",
      "variants": ["labels", "markers", "hidden"],
      "default": "labels"
    },
    "NamedSet": {
      "kind": "object",
      "fields": {
        "id": "string",
        "name": "string",
        "kind": "NamedSetKind",
        "selector": "string?",
        "refs": "SeriesRef[]"
      }
    },
    "Annotation": {
      "kind": "object",
      "fields": {
        "id": "string",
        "series_path": "string",
        "anchor": "f64",
        "pinned_x": "f64?",
        "pinned_value": "f64",
        "label": "string",
        "offset": "f64[2]"
      }
    },
    "PanelState": {
      "kind": "object",
      "fields": {
        "id": "string",
        "title": "string",
        "axis_style": "AxisStyle",
        "bindings": "Binding[]",
        "color_by": "StyleDimension?",
        "dash_by": "StyleDimension?",
        "width_by": "StyleDimension?",
        "line_width": "f32",
        "ghost_opacity": "f32",
        "overrides": "SeriesOverride[]",
        "focus": "FocusEntry[]",
        "ghost_mode": "GhostMode",
        "legend_state": "LegendState",
        "legend_position": "f64[2]?",
        "legend_size": "f64[2]?",
        "legend_anchor": "LegendAnchor?",
        "legend_dock": "LegendDock?",
        "legend_hint_dismissed": "bool",
        "x_axis": "SampleAxisSource",
        "color_axis": "ColorAxis?",
        "y_range": "f64[2]?",
        "x_range": "f64[2]?",
        "x_label": "string?",
        "y_label": "string?",
        "time_window": "f64[2]?",
        "annotations": "Annotation[]",
        "annotation_display": "AnnotationDisplay",
        "show_stats": "bool",
        "stat_columns": "StatColumn[]",
        "stats_sort": "StatColumn?",
        "stats_sort_descending": "bool"
      }
    },
    "LayoutCell": {
      "kind": "object",
      "fields": {
        "panel_id": "string",
        "width": "f64"
      }
    },
    "LayoutRow": {
      "kind": "object",
      "fields": {
        "height": "f64",
        "panels": "LayoutCell[]"
      }
    },
    "WorkspaceTab": {
      "kind": "object",
      "fields": {
        "id": "string",
        "title": "string",
        "cursor_mode": "CursorMode",
        "focused_panel_id": "string?",
        "maximized_panel_id": "string?",
        "panels": "PanelState[]",
        "layout": "LayoutRow[]"
      }
    },
    "DerivedSignal": {
      "kind": "object",
      "fields": {
        "path": "string",
        "expr": "string"
      }
    },
    "DerivedBundleState": {
      "kind": "object",
      "fields": {
        "name": "string",
        "expr": "string"
      }
    },
    "SourceRecord": {
      "kind": "object",
      "fields": {
        "key": "string",
        "path": "string",
        "prefix": "string",
        "provider_id": "string?",
        "decode_provenance": "string?",
        "recipe_id": "string?",
        "recipe_digest": "string?"
      }
    },
    "Session": {
      "kind": "object",
      "fields": {
        "app": "string",
        "title": "string?",
        "schema_version": "u32",
        "theme": "Theme",
        "linked_time": "LinkedTime",
        "active_tab_id": "string",
        "tabs": "WorkspaceTab[]",
        "named_sets": "NamedSet[]",
        "derived": "DerivedSignal[]",
        "derived_bundles": "DerivedBundleState[]",
        "sources": "SourceRecord[]"
      }
    }
  }
}
