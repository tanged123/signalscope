      "kind": "object",
      "fields": {
        "path": "string",
        "expr": "string"
      }
    },
    "RemoveSignalRequest": {
      "kind": "object",
      "fields": {
        "path": "string"
      }
    },
    "CreateDerivedBundleRequest": {
      "kind": "object",
      "fields": {
        "name": "string",
        "expr": "string"
      }
    },
    "RemoveDerivedBundleRequest": {
      "kind": "object",
      "fields": {
        "name": "string"
      }
    },
