        "t1": "f64",
        "first": "f64?",
        "last": "f64?",
        "min": "f64?",
        "max": "f64?",
        "sum": "f64",
        "sum_sq": "f64",
        "finite_count": "u64",
        "sample_count": "u64",
        "has_gap": "bool"
      }
