{
  "protocol_version": 19,
  "types": {
    "TimeWindow": {
      "kind": "object",
      "fields": {
        "t0": "f64",
        "t1": "f64"
      }
    },
    "IngestBatchRequest": {
      "kind": "object",
      "fields": {
        "paths": "string[]"
      }
    },
    "ScanSourcesRequest": {
      "kind": "object",
      "fields": {
        "path": "string",
        "recursive": "bool"
      }
    },
    "FormatCount": {
      "kind": "object",
      "fields": {
        "label": "string",
        "count": "u32"
      }
    },
    "ScanSourcesResponse": {
      "kind": "object",
      "fields": {
        "files": "string[]",
        "total_bytes": "u64",
        "format_counts": "FormatCount[]"
      }
    },
    "BatchJob": {
      "kind": "object",
      "fields": {
        "job_id": "u64"
      }
    },
    "BatchState": {
      "kind": "enum",
      "variants": ["running", "done", "partial", "failed", "cancelled"]
    },
    "FileState": {
      "kind": "enum",
      "variants": ["pending", "running", "done", "failed", "cancelled"]
    },
    "BatchFailure": {
      "kind": "object",
      "fields": {
        "path": "string",
        "error": "string",
        "recipe_required": "bool"
      }
    },
    "BatchStatus": {
      "kind": "object",
      "fields": {
        "state": "BatchState",
        "fraction": "f64",
        "total": "u64",
        "done": "u64",
        "failed": "u64",
        "current_paths": "string[]",
        "recent_failures": "BatchFailure[]"
      }
    },
    "BatchDetailRequest": {
      "kind": "object",
      "fields": {
        "job_id": "u64",
        "offset": "u32",
        "limit": "u32"
      }
    },
    "BatchFileStatus": {
      "kind": "object",
      "fields": {
        "path": "string",
        "state": "FileState",
        "error": "string?"
      }
    },
    "BatchDetail": {
      "kind": "object",
      "fields": {
        "entries": "BatchFileStatus[]",
        "total": "u64"
      }
    },
    "FormatDescriptor": {
      "kind": "object",
      "fields": {
        "id": "string",
        "label": "string",
        "extensions": "string[]"
      }
    },
    "IntrospectRequest": {
      "kind": "object",
      "fields": { "path": "string" }
    },
    "DatasetOutlineKind": {
      "kind": "enum",
      "variants": ["numeric", "text", "compound", "unsupported"]
    },
    "DatasetOutline": {
      "kind": "object",
      "fields": {
        "path": "string",
        "kind": "DatasetOutlineKind",
        "len": "u64",
        "shape": "u32[]",
        "sample_preview": "f64[]"
      }
    },
    "ContainerOutline": {
      "kind": "object",
      "fields": {
        "container": "string",
        "datasets": "DatasetOutline[]"
      }
    },
    "RecipeDestination": {
      "kind": "enum",
      "variants": ["sidecar", "user_directory"]
    },
    "SaveRecipeRequest": {
      "kind": "object",
      "fields": {
        "path": "string",
        "recipe_toml": "string",
        "destination": "RecipeDestination"
      }
    },
    "SaveRecipeResponse": {
      "kind": "object",
      "fields": {
        "recipe_id": "string",
        "digest": "string",
        "saved_to": "string"
      }
    },
    "RestoreSourcesRequest": {
      "kind": "object",
      "fields": {
        "session_json": "string"
      }
    },
    "RestoreFinalizeRequest": {
      "kind": "object",
      "fields": {
        "session_json": "string",
        "job_id": "u64"
      }
    },
    "RestoreFinalizeResponse": {
      "kind": "object",
      "fields": {
        "session_json": "string"
      }
    },
    "TileRequest": {
      "kind": "object",
      "fields": {
        "request_id": "string",
        "signal_ids": "u64[]",
        "window": "TimeWindow",
        "pixel_width": "u32"
      }
    },
    "Line2DRequest": {
      "kind": "object",
      "fields": {
        "request_id": "string",
        "x_signal_id": "u64",
        "y_signal_ids": "u64[]",
        "window": "TimeWindow",
        "pixel_width": "u32"
      }
    },
    "EnvelopeBin": {
      "kind": "object",
      "fields": {
        "t0": "f64",
        "t1": "f64",
        "first": "f64?",
        "last": "f64?",
        "min": "f64?",
        "max": "f64?",
        "sum": "f64",
        "sum_sq": "f64",
        "finite_count": "u64",
        "sample_count": "u64",
        "has_gap": "bool"
      }
    },
    "SignalTile": {
      "kind": "object",
      "fields": {
        "signal_id": "u64",
        "signal_path": "string",
        "unit": "string?",
        "level": "u32",
        "bins": "EnvelopeBin[]"
      }
    },
    "TileResponse": {
      "kind": "object",
      "fields": {
        "request_id": "string",
        "series": "SignalTile[]"
      }
    },
    "SampleRequest": {
      "kind": "object",
      "fields": {
        "request_id": "string",
        "signal_ids": "u64[]",
        "window": "TimeWindow",
        "max_points": "u32"
      }
    },
    "SampleSeries": {
      "kind": "object",
      "fields": {
        "signal_id": "u64",
        "signal_path": "string",
        "unit": "string?",
        "time": "f64[]",
        "values": "f64[]",
        "stride": "u32"
      }
    },
    "SampleResponse": {
      "kind": "object",
      "fields": {
        "request_id": "string",
        "series": "SampleSeries[]"
      }
    },
    "SignalSummary": {
      "kind": "object",
      "fields": {
        "signal_id": "u64",
        "source_id": "u64",
        "source_key": "string",
        "local_path": "string",
        "path": "string",
        "unit": "string?",
        "point_count": "u64",
        "t_min": "f64",
        "t_max": "f64",
        "last_value": "f64?"
      }
    },
    "SourceSummary": {
      "kind": "object",
      "fields": {
        "source_id": "u64",
        "source_key": "string",
        "prefix": "string",
        "path": "string",
        "point_count": "u64"
      }
    },
    "IngestStage": {
      "kind": "enum",
      "variants": ["decode", "pyramid", "cache"]
    },
    "DerivedRequest": {
      "kind": "object",
      "fields": {
        "path": "string",
        "expr": "string"
      }
    },
    "RemoveSignalRequest": {
      "kind": "object",
      "fields": {
        "path": "string"
      }
    },
    "CreateDerivedBundleRequest": {
      "kind": "object",
      "fields": {
        "name": "string",
        "expr": "string"
      }
    },
    "RemoveDerivedBundleRequest": {
      "kind": "object",
      "fields": {
        "name": "string"
      }
    },
    "SkippedMemberSummary": {
      "kind": "object",
      "fields": {
        "prefix": "string",
        "missing": "string[]"
      }
    },
    "DerivedBundleResponse": {
      "kind": "object",
      "fields": {
        "local_path": "string",
        "created": "SignalSummary[]",
        "skipped": "SkippedMemberSummary[]"
      }
    },
    "SessionDialogMode": {
      "kind": "enum",
      "variants": ["open", "save"]
    },
    "DragDropKind": {
      "kind": "enum",
      "variants": ["enter", "drop", "leave"]
    },
    "DragDropForward": {
      "kind": "object",
      "fields": {
        "kind": "DragDropKind",
        "paths": "string[]"
      }
    },
    "PickSessionRequest": {
      "kind": "object",
      "fields": {
        "mode": "SessionDialogMode"
      }
    },
    "SaveSessionRequest": {
      "kind": "object",
      "fields": {
        "session_json": "string",
        "path": "string?"
      }
    },
    "LoadSessionRequest": {
      "kind": "object",
      "fields": {
        "path": "string?"
      }
    },
    "LoadedSession": {
      "kind": "object",
      "fields": {
        "session_json": "string",
        "path": "string?"
      }
    },
    "ExportRange": {
      "kind": "enum",
      "variants": ["visible", "all"]
    },
    "ExportFidelity": {
      "kind": "enum",
      "variants": ["preview", "standard", "high", "full"]
    },
    "ExportEstimateRequest": {
      "kind": "object",
      "fields": {
        "session_json": "string",
        "selection": "ExportSelection"
      }
    },
    "ExportSelection": {
      "kind": "object",
      "fields": {
        "source_keys": "string[]"
      }
    },
    "ExportEstimate": {
      "kind": "object",
      "fields": {
        "entries": "ExportEstimateEntry[]"
      }
    },
    "ExportEstimateEntry": {
      "kind": "object",
      "fields": {
        "range": "ExportRange",
        "fidelity": "ExportFidelity",
        "bytes": "u64",
        "series_total": "u64",
        "series_decimated": "u64",
        "series_full_rate": "u64",
        "coarsest_ratio": "u64"
      }
    },
    "ExportWriteRequest": {
      "kind": "object",
      "fields": {
        "session_json": "string",
        "range": "ExportRange",
        "fidelity": "ExportFidelity",
        "selection": "ExportSelection",
        "preferences_json": "string?"
      }
    },
    "ExportFileKind": {
      "kind": "enum",
      "variants": ["png", "csv"]
    },
    "SaveExportFileRequest": {
      "kind": "object",
      "fields": {
        "file_name": "string",
        "kind": "ExportFileKind",
        "data_base64": "string"
      }
    },
    "SaveExportFileToDirectoryRequest": {
      "kind": "object",
      "fields": {
        "directory": "string",
        "file_name": "string",
        "kind": "ExportFileKind",
        "data_base64": "string"
      }
    },
    "BakedSignal": {
      "kind": "object",
      "fields": {
        "summary": "SignalSummary",
        "levels": "EnvelopeBin[][]"
      }
    },
    "BakedLine2DLevel": {
      "kind": "object",
      "fields": {
        "level": "u32",
        "anchor": "f64[]",
        "x": "f64?[]",
        "ys": "f64?[][]"
      }
    },
    "BakedLine2D": {
      "kind": "object",
      "fields": {
        "x_signal_id": "u64",
        "y_signal_ids": "u64[]",
        "levels": "BakedLine2DLevel[]"
      }
    },
    "SnapshotManifest": {
      "kind": "object",
      "fields": {
        "session_json": "string",
        "preferences_json": "string?",
        "signals": "BakedSignal[]",
        "line2d": "BakedLine2D[]?"
      }
    }
  }
}
