      "kind": "enum",
      "variants": ["visible", "all"]
    },
    "ExportFidelity": {
      "kind": "enum",
      "variants": ["preview", "standard", "high", "full"]
    },
    "ExportEstimateRequest": {
      "kind": "object",
      "fields": {
        "session_json": "string",
        "selection": "ExportSelection"
      }
    },
    "ExportSelection": {
      "kind": "object",
      "fields": {
        "source_keys": "string[]",
        "set_keys": "string[]"
      }
    },
