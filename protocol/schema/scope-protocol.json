        "series_total": "u64",
        "series_decimated": "u64",
        "series_full_rate": "u64",
        "coarsest_ratio": "u64"
      }
    },
    "ExportWriteRequest": {
      "kind": "object",
      "fields": {
        "session_json": "string",
        "range": "ExportRange",
        "fidelity": "ExportFidelity",
        "selection": "ExportSelection"
      }
