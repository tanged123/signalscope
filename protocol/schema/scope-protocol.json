      }
    },
    "TileResponse": {
      "kind": "object",
      "fields": {
        "request_id": "string",
        "series": "SignalTile[]"
      }
    },
    "SampleRequest": {
      "kind": "object",
      "fields": {
        "request_id": "string",
        "signal_ids": "u64[]",
        "window": "TimeWindow",
        "max_points": "u32"
      }
    },
    "SampleSeries": {
      "kind": "object",
      "fields": {
        "signal_id": "u64",
        "signal_path": "string",
        "unit": "string?",
        "time": "f64[]",
        "values": "f64[]",
        "stride": "u32"
      }
    },
    "SampleResponse": {
      "kind": "object",
      "fields": {
        "request_id": "string",
        "series": "SampleSeries[]"
      }
    },
