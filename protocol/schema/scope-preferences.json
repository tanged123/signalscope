{
  "schema_version": 6,
  "types": {
    "FontFamily": {
      "kind": "enum",
      "variants": ["inter", "dejavu", "arimo", "jetbrains"],
      "default": "inter"
    },
    "Theme": {
      "kind": "enum",
      "variants": ["dark", "light"],
      "default": "dark"
    },
    "Preferences": {
      "kind": "object",
      "fields": {
        "schema_version": "u32",
        "theme": "Theme",
        "ui_font_family": "FontFamily",
        "plot_font_family": "FontFamily",
        "ui_font_size": "f64",
        "plot_font_size": "f64",
        "plot_line_width_scale": "f64",
        "cache_root": "string?",
        "cache_max_bytes": "u64",
        "ingest_working_bytes": "u64?",
        "ingest_resident_bytes": "u64?",
        "recipe_directory": "string?"
      }
    }
  }
}
